<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:padding="16dp">

  <TextView
    android:id="@+id/tvTitle"
    android:text="@string/title"
    android:textSize="24sp"
    android:textStyle="bold"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <TextView
    android:id="@+id/tvWho"
    android:text="@string/who_turn"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/tvTitle"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <TextView
    android:id="@+id/tvGamesWon"
    android:text="@string/games_won"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/tvWho"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <LinearLayout
    android:id="@+id/diceRow"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/tvGamesWon"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <ImageView
      android:id="@+id/imgDie1"
      android:layout_width="72dp"
      android:layout_height="72dp"
      android:layout_marginEnd="16dp"
      android:src="@drawable/dice_1" />

    <ImageView
      android:id="@+id/imgDie2"
      android:layout_width="72dp"
      android:layout_height="72dp"
      android:src="@drawable/dice_1" />
  </LinearLayout>

  <TextView
    android:id="@+id/tvRollSum"
    android:text="@string/roll_sum"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/diceRow"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <TextView
    android:id="@+id/tvTotalScore"
    android:text="@string/total_score"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/tvRollSum"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <TextView
    android:id="@+id/tvTurnScore"
    android:text="@string/turn_score"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    app:layout_constraintTop_toBottomOf="@id/tvTotalScore"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <LinearLayout
    android:id="@+id/buttonRow"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/tvTurnScore"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <Button
      android:id="@+id/btnRoll"
      android:text="@string/roll"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="24dp"/>

    <Button
      android:id="@+id/btnHold"
      android:text="@string/hold"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"/>
  </LinearLayout>

  <Button
    android:id="@+id/btnLeaderboard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/leaderboard_button"
    android:layout_marginTop="12dp"
    app:layout_constraintTop_toBottomOf="@id/buttonRow"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <ImageView
    android:id="@+id/imgResult"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_marginTop="16dp"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/btnLeaderboard"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <TextView
    android:id="@+id/tvTapStart"
    android:text="@string/start_new"
    android:visibility="gone"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/imgResult"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
